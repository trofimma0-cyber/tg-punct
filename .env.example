BOT_TOKEN = 8835076415:AAE592ovrjyj5svBRRc6CO2aK5Mq2SIDyWU

# Если Telegram API заблокирован без VPN и твой VPN-клиент проксирует
# только браузер (не системный трафик) — пропиши адрес локального прокси.
# Для Koala Clash (и других clash-verge-based клиентов) обычно 127.0.0.1:7897
# (проверь порт в файле work/config.yaml внутри папки клиента, если не совпадает).
PROXY_URL=http://127.0.0.1:7897

# Через запятую: username чатов, которые бот НЕ должен трогать (по желанию)
